# Public origin used for canonical URLs and social sharing metadata in production.
# Example: https://app.example.com
NEXT_PUBLIC_APP_URL=

# Which network the app runs against. Start and stay on testnet for the
# entire hackathon build — flip to mainnet only per Phase 9's soak-tested,
# feature-flagged rollout.
NEXT_PUBLIC_SOMNIA_NETWORK=

# Privy — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only — Settings -> API Keys in the Privy dashboard
PRIVY_APP_SECRET=
# One-time setup, see docs/PHASE-2-AUTH.md — the public half of this
# key pair is registered in the Privy dashboard as an app authorization
# key. Not required to run Phase 2's auth flow; only used starting
# Phase 5 (redemption automation).
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# DreamDEX / Somnia Markets SDK (Phase 3) — NOT confirmed values, fill
# from DreamDEX's current docs/dashboard. See docs/PHASE-3-MARKET-CURATION.md.
SOMNIA_MARKETS_INDEXER_URL=
SOMNIA_MARKETS_WS_RPC_URL=
VALIDATION_CLOUD_RPC=
VALIDATION_CLOUD_WSS=
# Throwaway, zero-funds keypair — this job only ever reads.
SYNC_JOB_PRIVATE_KEY=
# openssl rand -hex 32
SYNC_JOB_SECRET=
ADMIN_API_SECRET=

# Optional Telegram bot link. If set, the header shows this instead of the
# in-app claim button.
NEXT_PUBLIC_TESTNET_FAUCET_BOT_URL=

# Optional browser fallback. Only set these if the provider token may be
# exposed to browsers; otherwise leave blank and use the server-only values.
NEXT_PUBLIC_VALIDATION_CLOUD_RPC=
NEXT_PUBLIC_VALIDATION_CLOUD_WSS=

# Testnet faucet. Keep the private key server-only. The defaults grant each
# linked wallet 1 STT and 10 tUSDC once per UTC day.
FAUCET_PRIVATE_KEY=
FAUCET_STT_AMOUNT=1
FAUCET_TUSDC_AMOUNT=10

# Supabase — TESTNET project (separate project from mainnet, not a schema
# flag — see docs/PHASE-0-SETUP.md)
NEXT_PUBLIC_SUPABASE_URL_TESTNET=
NEXT_PUBLIC_SUPABASE_ANON_KEY_TESTNET=
SUPABASE_SERVICE_ROLE_KEY_TESTNET=
SUPABASE_PROJECT_ID=

# Supabase — MAINNET project (leave blank until Phase 9)
NEXT_PUBLIC_SUPABASE_URL_MAINNET=
NEXT_PUBLIC_SUPABASE_ANON_KEY_MAINNET=
SUPABASE_SERVICE_ROLE_KEY_MAINNET=
